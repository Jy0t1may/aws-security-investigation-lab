{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyInsecureTransport",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::awslab-audit-c2b8fb5274a4f0eaf19e0a97bd",
        "arn:aws:s3:::awslab-audit-c2b8fb5274a4f0eaf19e0a97bd/*"
      ],
      "Condition": {
        "Bool": {
          "aws:PrincipalIsAWSService": "false",
          "aws:SecureTransport": "false"
        }
      }
    },
    {
      "Sid": "CloudTrailAclCheck",
      "Effect": "Allow",
      "Principal": {
        "Service": "cloudtrail.amazonaws.com"
      },
      "Action": "s3:GetBucketAcl",
      "Resource": "arn:aws:s3:::awslab-audit-c2b8fb5274a4f0eaf19e0a97bd",
      "Condition": {
        "StringEquals": {
          "aws:SourceArn": "arn:aws:cloudtrail:eu-north-1:625867802773:trail/awslab-management"
        }
      }
    },
    {
      "Sid": "CloudTrailLogDelivery",
      "Effect": "Allow",
      "Principal": {
        "Service": "cloudtrail.amazonaws.com"
      },
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::awslab-audit-c2b8fb5274a4f0eaf19e0a97bd/AWSLogs/625867802773/*",
      "Condition": {
        "StringEquals": {
          "s3:x-amz-acl": "bucket-owner-full-control",
          "aws:SourceArn": "arn:aws:cloudtrail:eu-north-1:625867802773:trail/awslab-management"
        }
      }
    }
  ]
}