{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TrustLabOperatorOnly",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::625867802773:root"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "ArnEquals": {
          "aws:PrincipalArn": "arn:aws:iam::625867802773:role/managed/AccountFullAccessRole"
        }
      }
    }
  ]
}